generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  clients      Client[]
  projects     Project[]
  entries      TimeEntry[]
  timers       ActiveTimer[]
  invoices     Invoice[]
  createdAt    DateTime      @default(now())
}

model Client {
  id          String    @id @default(cuid())
  userId      String
  name        String
  email       String?
  companyName String?
  notes       String?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects    Project[]
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Project {
  id          String        @id @default(cuid())
  userId      String
  clientId    String
  name        String
  description String?
  hourlyRate  Decimal       @db.Decimal(12, 2)
  currency    String        @default("USD")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  entries     TimeEntry[]
  timers      ActiveTimer[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, clientId])
}

model ActiveTimer {
  id        String   @id @default(cuid())
  userId    String   @unique
  projectId String
  description String?
  startedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
}

model TimeEntry {
  id                  String       @id @default(cuid())
  userId              String
  projectId           String
  description         String?
  startTime           DateTime
  endTime             DateTime
  durationSeconds     Int
  billable            Boolean      @default(true)
  hourlyRateSnapshot  Decimal      @db.Decimal(12, 2)
  invoiceLine         InvoiceLine?
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([userId, startTime])
}

model Invoice {
  id          String        @id @default(cuid())
  userId      String
  clientId    String
  invoiceNumber String
  issueDate   DateTime      @default(now())
  periodStart DateTime
  periodEnd   DateTime
  currency    String
  subtotal    Decimal       @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lines       InvoiceLine[]
  createdAt   DateTime      @default(now())

  @@unique([userId, invoiceNumber])
}

model InvoiceLine {
  id          String    @id @default(cuid())
  invoiceId   String
  timeEntryId String    @unique
  description String
  dateWorked  DateTime
  hours       Decimal   @db.Decimal(10, 4)
  hourlyRate  Decimal   @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(12, 2)
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Restrict)
}
